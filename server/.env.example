# Copy to .env only for local development. Never commit real values.
NODE_ENV=development
DEPLOYMENT_STAGE=development
HOST=127.0.0.1
PORT=4242
DATABASE_PATH=./data/drip.sqlite

# SQLite remains the transaction ledger for inventory
# reservations, orders, Stripe webhooks, payouts, and rate limits. Production
# can use server-only Cloud Firestore as the marketplace catalog source.
MARKETPLACE_DATABASE_PROVIDER=sqlite
FIREBASE_PROJECT_ID=dripproject-24882
FIREBASE_CONNECT_TIMEOUT_MS=10000

# Local/self-hosted Firebase Auth can verify each ID token and current account
# through Firebase's official accounts:lookup REST endpoint. Paste the Web API
# key for FIREBASE_PROJECT_ID here; do not use a service-account private key.
FIREBASE_AUTH_VERIFIER_MODE=rest-api-key
FIREBASE_WEB_API_KEY=<firebase-web-api-key>

# Production should prefer Firebase Admin with Application Default Credentials:
# FIREBASE_AUTH_VERIFIER_MODE=application-default
# FIREBASE_CREDENTIALS_MODE=application-default
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/drip-firebase-service-account.json
#
# Firestore always requires FIREBASE_CREDENTIALS_MODE=application-default,
# including when Auth uses rest-api-key. Never commit a service-account file.
FIREBASE_CREDENTIALS_MODE=
GOOGLE_APPLICATION_CREDENTIALS=

# The service starts without these, but checkout returns payments_unavailable.
# Use a Stripe sandbox server key. A least-privilege rk_test_ key is preferred
# when its Checkout/Session permissions cover this service; sk_test_ also works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Seller onboarding uses Stripe Accounts v2 with the recipient configuration.
# The Connect destination uses its own signing secret. Both URLs must be HTTPS.
# The refresh URL is an informational page only; a fresh single-use onboarding
# link is created only by the authenticated app endpoint.
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_WEBHOOK_SECRET=
CONNECT_ONBOARDING_RETURN_URL=https://app.example.com/connect/return
CONNECT_ONBOARDING_REFRESH_URL=https://api.example.com/connect/onboarding/refresh
CONNECT_DEFAULT_COUNTRY=US
CONNECT_DEFAULT_CURRENCY=usd

# Drip AI is server-only and fails closed when disabled or unconfigured. Never
# put this key in Flutter, a Dart define, browser code, logs, or source control.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODERATION_MODEL=omni-moderation-latest
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=900
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_PER_DAY=200

# Stripe replaces this exact token after payment.
CHECKOUT_SUCCESS_URL=http://localhost:4242/checkout/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:4242/checkout/cancel
CHECKOUT_ALLOWED_COUNTRIES=US
CHECKOUT_RESERVATION_MINUTES=31

# Comma-separated exact origins. Requests without Origin (mobile, Stripe CLI)
# remain valid. Wildcards are intentionally unsupported.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Development uses the fixed Drip demo buyer. Set firebase to accept verified
# Firebase ID tokens from Flutter; production allows firebase or jwt.
AUTH_MODE=firebase
DEV_BUYER_ID=dev-alex
DEV_BUYER_SELLER_HANDLE=@alexwears
JWT_HS256_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# Built-in accounts are disabled until JWT and real email delivery are both
# configured. Secrets stay on this server; never put them in Flutter.
ACCOUNT_AUTH_ENABLED=false
AUTH_SESSION_TTL_SECONDS=604800
AUTH_SIGNUP_RATE_LIMIT_PER_HOUR=5
AUTH_LOGIN_RATE_LIMIT_PER_15_MINUTES=10
AUTH_VERIFICATION_CODE_TTL_SECONDS=600
AUTH_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
AUTH_VERIFICATION_RESEND_LIMIT_PER_HOUR=5
AUTH_VERIFICATION_ATTEMPT_RATE_LIMIT_PER_15_MINUTES=20
AUTH_PENDING_ACCOUNT_TTL_SECONDS=86400
# Optional; defaults to JWT_HS256_SECRET. Use a separate 32+ byte secret in
# production when operationally practical.
AUTH_RATE_LIMIT_SECRET=
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
WELCOME_EMAIL_FROM="Drip <welcome@example.com>"
EMAIL_TIMEOUT_MS=10000
WELCOME_EMAIL_RETRY_INTERVAL_MS=60000

# Optional Firebase-account six-digit codes. This is separate from the built-in
# JWT account system and remains off unless every value is configured. It
# requires Firebase Admin application-default mode above; rest-api-key mode
# cannot update emailVerified. Verify the sender domain with Resend first.
FIREBASE_EMAIL_CODE_ENABLED=false
FIREBASE_EMAIL_CODE_SECRET=
FIREBASE_EMAIL_CODE_TTL_SECONDS=600
FIREBASE_EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
FIREBASE_EMAIL_CODE_RESEND_LIMIT_PER_HOUR=5
FIREBASE_EMAIL_CODE_IP_REQUEST_LIMIT_PER_HOUR=20
FIREBASE_EMAIL_CODE_ATTEMPT_LIMIT_PER_15_MINUTES=20
FIREBASE_EMAIL_CODE_MAX_ATTEMPTS=5

# Seed data has no Stripe Connect accounts. Set true only after populating
# seller_accounts with connected accounts whose transfers capability is active.
REQUIRE_CONNECT_PAYOUTS=false
