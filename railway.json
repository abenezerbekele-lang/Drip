{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "server/Dockerfile.railway",
    "watchPatterns": [
      "server/src/**",
      "server/package.json",
      "server/package-lock.json",
      "server/container-entrypoint.js",
      "server/Dockerfile.railway",
      "server/data/catalog.json",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": 0,
    "drainingSeconds": 20
  }
}
