# Non-secret staging variables for the Railway service. Add values through
# Railway Variables; do not upload this file with real credentials.
NODE_ENV=production
DEPLOYMENT_STAGE=staging
HOST=0.0.0.0
DATABASE_PATH=/data/drip.sqlite
MARKETPLACE_DATABASE_PROVIDER=sqlite

AUTH_MODE=firebase
ACCOUNT_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=dripproject-24882
FIREBASE_AUTH_VERIFIER_MODE=rest-api-key
FIREBASE_WEB_API_KEY=
FIREBASE_CONNECT_TIMEOUT_MS=10000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ENABLED=false

CHECKOUT_SUCCESS_URL=https://YOUR_RAILWAY_DOMAIN/checkout/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=https://YOUR_RAILWAY_DOMAIN/checkout/cancel
CHECKOUT_ALLOWED_COUNTRIES=US
CHECKOUT_RESERVATION_MINUTES=31
CORS_ALLOWED_ORIGINS=https://YOUR_WEB_APP_DOMAIN

AI_ENABLED=false
EMAIL_PROVIDER=disabled
FIREBASE_EMAIL_CODE_ENABLED=false
REQUIRE_CONNECT_PAYOUTS=false
