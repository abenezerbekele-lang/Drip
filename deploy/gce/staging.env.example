# Copy to /etc/drip/staging.env on the host, make it root-readable only, and
# inject the two Stripe values from a secret manager. Never commit the result.
NODE_ENV=production
DEPLOYMENT_STAGE=staging
HOST=0.0.0.0
PORT=4242
DATABASE_PATH=/var/lib/drip/drip.sqlite

# Keep one authoritative SQLite catalog for this staging deployment. The
# Firestore catalog adapter is not yet the transaction source used by checkout.
MARKETPLACE_DATABASE_PROVIDER=sqlite

AUTH_MODE=firebase
ACCOUNT_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=dripproject-24882
FIREBASE_AUTH_VERIFIER_MODE=application-default
FIREBASE_CREDENTIALS_MODE=application-default
FIREBASE_CONNECT_TIMEOUT_MS=10000

# Use Stripe sandbox/test credentials only in staging. These stay blank in the
# repository copy and must be supplied on the host.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ENABLED=false

CHECKOUT_SUCCESS_URL=https://api-staging.example.com/checkout/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=https://api-staging.example.com/checkout/cancel
CHECKOUT_ALLOWED_COUNTRIES=US
CHECKOUT_RESERVATION_MINUTES=31
CORS_ALLOWED_ORIGINS=https://staging.example.com

AI_ENABLED=false
EMAIL_PROVIDER=disabled
FIREBASE_EMAIL_CODE_ENABLED=false
REQUIRE_CONNECT_PAYOUTS=false
