rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Drip reads and writes this database only through the authenticated
    // server-side Firebase Admin SDK. Mobile and web clients get no direct
    // access; the service account is restricted with Google Cloud IAM.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
